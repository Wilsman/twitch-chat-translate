{
  "manifest_version": 3,
  "name": "Chat Translate for Twitch",
  "version": "1.0.0",
  "description": "Detects foreign-language Twitch chat messages and translates them inline, on-device.",
  "homepage_url": "https://github.com/Wilsman/twitch-chat-translate",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://translate.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Chat Translate",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.twitch.tv/*"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
